# ==========================================
# Server Configuration
# ==========================================
# The port number on which the backend Express server will run
# Default: 5000
PORT=5000

# ==========================================
# Database Configuration
# ==========================================
# MongoDB connection string (e.g., mongodb://localhost:27017/foru or MongoDB Atlas URI)
# Optional: Reserved for future database storage
MONGODB_URI=mongodb_uri_here

# ==========================================
# Discord Notifications
# ==========================================
# Discord Webhook URL to receive live notifications when someone responds
# How to get: Discord Channel Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL=webhook_url_here

# ==========================================
# Discord Bot
# ==========================================
# Discord Bot Token to run interactive commands (!tembak or !gombal)
# How to get: Discord Developer Portal (https://discord.com/developers/applications) -> Bot tab -> Reset Token
# Note: Ensure Message Content Intent is enabled under the Bot settings
DISCORD_BOT_TOKEN=bot_token_here

# ==========================================
# Frontend Configuration
# ==========================================
# Base URL of the frontend client application
# Used by the Discord bot to construct shareable target links (e.g., FRONTEND_URL/?target=...)
# Local development: http://localhost:5173 | Production: https://yourdomain.com
FRONTEND_URL=http://localhost:5173
